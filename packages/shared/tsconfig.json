{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@builderp/config/tsconfig/base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "isolatedModules": false,
    "baseUrl": "."
  },
  "include": ["src/**/*"]
}
